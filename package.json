{
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:db": "npm run db:up && vitest run --config vitest.integration.config.mts",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:preview": "playwright test",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:reset": "npx supabase db reset",
    "supabase:env": "node scripts/supabase-env.mjs",
    "setup:local": "npm run supabase:start && npm run supabase:reset && npm run supabase:env",
    "test:rest": "npm run rest:up && vitest run --config vitest.rest.config.mts",
    "test:mcp": "vitest run --config vitest.mcp.config.mts",
    "test:storage": "vitest run --config vitest.storage.config.mts",
    "mcp:token": "node scripts/mcp-token.mjs",
    "rest:up": "docker compose -f docker-compose.test.yml --profile rest up -d --wait",
    "db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.test.yml down -v",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:db && npm run test:rest && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-slot": "^1.2.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "mcp-handler": "^2.3.1",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "pg": "^8.23.1",
    "postcss": "^8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
