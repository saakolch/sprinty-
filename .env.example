# ---------------------------------------------------------------------------
# LifeOS — environment variables
#
# Copy to `.env.local` for local development:
#   cp .env.example .env.local
#
# Local values come from `supabase start` (or `npx supabase status`).
# Never commit real keys. The service-role key bypasses RLS and must only be
# used in server-side code and test setup.
# ---------------------------------------------------------------------------

# Public: safe to expose to the browser (protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only: bypasses RLS. Used for seeding / admin tasks. Never expose.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Test harness: Postgres used by `npm run test:db` (docker-compose.test.yml).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
